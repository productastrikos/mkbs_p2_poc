{
  "name": "greenlight-evp",
  "version": "0.1.0",
  "description": "GreenLight EVP: AI-assisted emergency vehicle pre-emption prototype for MBKS (Kuching South) on SCATS",
  "private": true,
  "engines": {
    "node": ">=20.12"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "chart.js": "^4.4.0",
    "leaflet": "^1.9.4",
    "react": "^18.2.0",
    "react-chartjs-2": "^5.2.0",
    "react-dom": "^18.2.0",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "react-scripts": "5.0.1"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.16",
    "tailwindcss": "^3.3.5"
  },
  "scripts": {
    "start": "react-scripts start",
    "dev": "react-scripts start",
    "build": "react-scripts build",
    "serve": "node server/index.js",
    "data": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/fetch-osm.mjs && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/build-data.mjs",
    "data:trips": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-trips.mjs",
    "check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/acceptance.mjs",
    "test": "react-scripts test"
  },
  "eslintConfig": {
    "extends": [
      "react-app"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  }
}
